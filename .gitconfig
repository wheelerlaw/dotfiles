[user]
	name = Wheeler Law
[push]
	default = current
[init]
	defaultBranch = main
[alias]
	squash-branch = "!f() {\n  base=\"${1:-origin/main}\";\n  mb=$(git merge-base HEAD \"$base\") || exit 1;\n  first=$(git rev-list \"$mb\"..HEAD | tail -1);\n  [ -n \"$first\" ] || { echo \"No commits to squash between HEAD and $base (merge-base $mb)\" >&2; exit 1; }\n  git reset --soft \"$mb\" && git commit -C \"$first\";\n}; f"
[log]
	date = iso-local

# Use GitHub CLI for credentials, which itself reaches into 1Password for the token
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Local config not to be committed into the dotfiles
[include]
	path = ~/.local/etc/gitconfig

# Path-based config, used for auth-configuring committer emails based on repo location
[includeIf "gitdir:~/Repositories/github.com/"]
	path = ~/Repositories/github.com/.gitconfig
